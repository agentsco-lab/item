From 9ca950fb6588f66a80f326653d1db9fd00d918fe Mon Sep 17 00:00:00 2001
From: Ivan Verbovoy <145046797+iverbovoy@users.noreply.github.com>
Date: Thu, 24 Sep 2026 22:27:22 +0300
Subject: [PATCH 12/17] running apps only placed and follows redo the rows

---
 src/running-apps.c | 25 +++++++++++++++++++++++--
 1 file changed, 23 insertions(+), 2 deletions(-)

diff --git a/src/running-apps.c b/src/running-apps.c
index 6353160c..8f017091 100644
--- a/src/running-apps.c
+++ b/src/running-apps.c
@@ -281,6 +281,27 @@ on_row_activated (PhoshRunningApps *self, GtkListBoxRow *row)
 }
 
 
+/*
+ * The dock says more than where windows are: Busy changes with every panel
+ * the grid or a window takes. Only Placed and Follows change a row, and
+ * redoing every row for the rest redrew the shade's list - hidden, folded -
+ * each time the grid rose or fell: 414x1472 and 552x1670 of the shade uploaded
+ * inside the grid's slide, which lost frames to it (#148).
+ */
+static void
+on_dock_properties_changed (PhoshRunningApps *self,
+                            GVariant         *changed,
+                            GStrv             invalidated,
+                            GDBusProxy       *proxy)
+{
+  g_autoptr (GVariant) placed = g_variant_lookup_value (changed, "Placed", NULL);
+  g_autoptr (GVariant) follows = g_variant_lookup_value (changed, "Follows", NULL);
+
+  if (placed || follows || (invalidated && invalidated[0]))
+    update_all_rows (self);
+}
+
+
 static void
 on_dock_proxy_ready (GObject *source, GAsyncResult *res, gpointer data)
 {
@@ -294,8 +315,8 @@ on_dock_proxy_ready (GObject *source, GAsyncResult *res, gpointer data)
   }
   self = PHOSH_RUNNING_APPS (data);
   self->dock = proxy;
-  g_signal_connect_object (proxy, "g-properties-changed", G_CALLBACK (update_all_rows), self,
-                           G_CONNECT_SWAPPED);
+  g_signal_connect_object (proxy, "g-properties-changed", G_CALLBACK (on_dock_properties_changed),
+                           self, G_CONNECT_SWAPPED);
   /* the dock coming or going changes what is known */
   g_signal_connect_object (proxy, "notify::g-name-owner", G_CALLBACK (update_all_rows), self,
                            G_CONNECT_SWAPPED);
-- 
