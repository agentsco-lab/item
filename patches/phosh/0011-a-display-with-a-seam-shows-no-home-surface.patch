From 697b9fb5139ef88a8337398941b2aac30a9d363a Mon Sep 17 00:00:00 2001
From: Ivan Verbovoy <145046797+iverbovoy@users.noreply.github.com>
Date: Thu, 24 Sep 2026 22:27:22 +0300
Subject: [PATCH 11/17] a display with a seam shows no home surface

---
 src/shell.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/shell.c b/src/shell.c
index 8016934a..3d6e60b6 100644
--- a/src/shell.c
+++ b/src/shell.c
@@ -733,6 +733,17 @@ panels_create (PhoshShell *self)
                                                    phosh_wayland_get_zphoc_layer_shell_effects_v1 (wl),
                                                    monitor));
   g_object_bind_property (self, "overview-visible", priv->home, "visible", G_BINDING_SYNC_CREATE);
+  /* On a display with a seam the home surface is never seen: it has no home
+   * bar there (home.c) and the shell's dock holds the applications. Shown
+   * anyway, it redrew the whole of itself - 2784x5952 on this phone - two
+   * or three times as the last window closed, ~20 ms of upload each, and
+   * the window's own fade lost 3-4 frames to it (#147). */
+  {
+    GdkRectangle seam;
+
+    if (phosh_layout_manager_get_seam (priv->layout_manager, &seam))
+      g_object_set (self, "overview-visible", FALSE, NULL);
+  }
 
   g_signal_connect_swapped (priv->top_panel,
                             "activated",
