+static gboolean
+is_volume (PhoshOsdWindow *self)
+{
+  return self->icon_name && g_str_has_prefix (self->icon_name, "audio-volume-");
+}
+
+#define SLIDER_WIDTH  24     /* what a finger can hit */
+#define BAR_WIDTH      7     /* what is seen, down its right side */
+#define BAR_RIGHT      2
+
+/* The bar: a track, and the level filled in the accent colour from the
+ * bottom - drawn here to the pixel: a GtkScale gave its trough 11px
+ * whatever its CSS asked, and its fill stood a pixel off the trough */
+static gboolean
+on_slider_draw (PhoshOsdWindow *self, cairo_t *cr)
+{
+  int w = gtk_widget_get_allocated_width (self->slider);
+  int h = gtk_widget_get_allocated_height (self->slider);
+  double x = w - BAR_RIGHT - BAR_WIDTH, r = BAR_WIDTH / 2.0;
+  double share = self->max_level > 0 ? CLAMP (self->level / self->max_level, 0.0, 1.0) : 0.0;
+  double top = h * (1.0 - share);
+
+  cairo_new_sub_path (cr);
+  cairo_arc (cr, x + r, r, r, G_PI, 1.5 * G_PI);
+  cairo_arc (cr, x + BAR_WIDTH - r, r, r, 1.5 * G_PI, 2 * G_PI);
+  cairo_arc (cr, x + BAR_WIDTH - r, h - r, r, 0, 0.5 * G_PI);
+  cairo_arc (cr, x + r, h - r, r, 0.5 * G_PI, G_PI);
+  cairo_close_path (cr);
+  cairo_set_source_rgba (cr, 0, 0, 0, 0.35);        /* seen on a light wallpaper too */
+  cairo_set_line_width (cr, 2);
+  cairo_stroke_preserve (cr);
+  cairo_set_source_rgba (cr, 1, 1, 1, 0.3);
+  cairo_fill_preserve (cr);
+
+  cairo_clip (cr);
+  cairo_rectangle (cr, x, top, BAR_WIDTH, h - top);
+  cairo_set_source_rgb (cr, self->accent[0], self->accent[1], self->accent[2]);
+  cairo_fill (cr);
+  return TRUE;
+}
+
+
+/* A finger on the slider sets the output volume - the volume keys bring
+ * the slider up, and a finger takes it from there: up as well as down,
+ * with a key that no longer works. */
+static void
+set_volume_to (PhoshOsdWindow *self, double value)
+{
+  PhoshAudioManager *audio = phosh_audio_manager_get_default ();
+  GvcMixerStream *sink;
+  double max = MAX (self->max_level, 0.01), share;
+  pa_volume_t norm;
+  const char *icon;
+
+  self->moved_at = g_get_monotonic_time ();
+  if (!is_volume (self) || audio == NULL)
+    return;
+  sink = phosh_audio_manager_get_default_sink (audio);
+  if (sink == NULL)
+    return;
+
+  value = CLAMP (value, 0.0, max);
+  share = value / max;
+  norm = gvc_mixer_control_get_vol_max_norm (phosh_audio_manager_get_mixer_control (audio));
+  if (gvc_mixer_stream_set_volume (sink, (pa_volume_t) (norm * value + 0.5)))
+    gvc_mixer_stream_push_volume (sink);
+  gvc_mixer_stream_change_is_muted (sink, value <= 0.0);
+
+  self->level = value;
+  gtk_widget_queue_draw (self->slider);
+  icon = value <= 0.0 ? "audio-volume-muted-symbolic" :
+    share < 0.34 ? "audio-volume-low-symbolic" :
+    share < 0.67 ? "audio-volume-medium-symbolic" : "audio-volume-high-symbolic";
+  g_free (self->icon_name);
+  self->icon_name = g_strdup (icon);
+  gtk_image_set_from_icon_name (GTK_IMAGE (self->icon), icon, GTK_ICON_SIZE_INVALID);
+}
+
+
+/* Wherever the finger lands on the bar the level is there, and it follows
+ * the finger - no knob to find first */
+static void
+drag_to (PhoshOsdWindow *self, double y)
+{
+  int height = gtk_widget_get_allocated_height (self->slider);
+  double share;
+
+  if (height <= 0)
+    return;
+  share = CLAMP (1.0 - y / height, 0.0, 1.0);
+  set_volume_to (self, share * MAX (self->max_level, 0.01));
+}
+
+
+static void
+on_drag_begin (PhoshOsdWindow *self, double x, double y)
+{
+  gtk_gesture_set_state (self->drag, GTK_EVENT_SEQUENCE_CLAIMED);
+  self->dragging = TRUE;
+  self->drag_y = y;
+  drag_to (self, y);
+}
+
+
+static void
+on_drag_update (PhoshOsdWindow *self, double dx, double dy)
+{
+  drag_to (self, self->drag_y + dy);
+}
+
+
+static void
+on_drag_end (PhoshOsdWindow *self)
+{
+  self->dragging = FALSE;
+  self->moved_at = g_get_monotonic_time ();
+}
+
+
+/**
+ * phosh_osd_window_is_held:
+ *
+ * Returns: whether a finger is on its slider, or was a moment ago - it
+ * stays up while it is
+ */
+gboolean
+phosh_osd_window_is_held (PhoshOsdWindow *self)
+{
+  g_return_val_if_fail (PHOSH_IS_OSD_WINDOW (self), FALSE);
+
+  if (!self->upright)
+    return FALSE;
+  if (self->dragging)
+    return TRUE;
+  return g_get_monotonic_time () - self->moved_at < OSD_HOLD_US;
+}
+
+
+static gboolean
+fade_tick (GtkWidget *widget, GdkFrameClock *clock, gpointer unused)
+{
+  PhoshOsdWindow *self = PHOSH_OSD_WINDOW (widget);
+  GtkWidget *child = gtk_bin_get_child (GTK_BIN (self));
+  double k = (g_get_monotonic_time () - self->fade_start) /
+    (double) (self->fade_to > 0.0 ? OSD_FADE_IN_US : OSD_FADE_OUT_US);
+
+  k = CLAMP (k, 0.0, 1.0);
+  if (child)
+    gtk_widget_set_opacity (child, self->fade_from + (self->fade_to - self->fade_from) * k);
+  if (k < 1.0)
+    return G_SOURCE_CONTINUE;
+
+  self->fade_id = 0;
+  if (self->fade_to <= 0.0)
+    gtk_widget_destroy (widget);
+  return G_SOURCE_REMOVE;
+}
+
+
+static void
+fade_to (PhoshOsdWindow *self, double to)
+{
+  GtkWidget *child = gtk_bin_get_child (GTK_BIN (self));
+
+  if (self->fade_id)
+    gtk_widget_remove_tick_callback (GTK_WIDGET (self), self->fade_id);
+  self->fade_from = child ? gtk_widget_get_opacity (child) : 0.0;
+  self->fade_to = to;
+  self->fade_start = g_get_monotonic_time ();
+  self->fade_id = gtk_widget_add_tick_callback (GTK_WIDGET (self), fade_tick, NULL, NULL);
+}
+
+/**
+ * phosh_osd_window_fade_out:
+ *
+ * Fades it away where it stands, then destroys it. Shown again meanwhile
+ * (phosh_osd_window_fade_in) it stays.
+ */
+void
+phosh_osd_window_fade_out (PhoshOsdWindow *self)
+{
+  g_return_if_fail (PHOSH_IS_OSD_WINDOW (self));
+  fade_to (self, 0.0);
+}
+
+
+void
+phosh_osd_window_fade_in (PhoshOsdWindow *self)
+{
+  g_return_if_fail (PHOSH_IS_OSD_WINDOW (self));
+  if (self->fade_id == 0 || self->fade_to < 1.0)
+    fade_to (self, 1.0);
+}
+
