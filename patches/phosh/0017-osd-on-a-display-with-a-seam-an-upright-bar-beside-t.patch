+/* Upright: the bubble a column, the slider above the icon, rising */
+/* The accent colours, as the dock has them (libadwaita's) */
+static const struct { const char *name, *rgb; } accents[] = {
+  { "blue", "53,132,228" }, { "teal", "33,144,164" }, { "green", "58,148,74" },
+  { "yellow", "200,136,0" }, { "orange", "237,91,0" }, { "red", "230,45,66" },
+  { "pink", "213,97,153" }, { "purple", "145,65,172" }, { "slate", "111,131,150" },
+};
+
+/* The filled part of the bar in the accent colour, as the dock's own */
+static void
+paint_accent (PhoshOsdWindow *self)
+{
+  g_autoptr (GSettingsSchema) schema = NULL;
+  g_autoptr (GSettings) settings = NULL;
+  g_autofree char *name = NULL;
+  int red, green, blue;
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  const char *rgb = accents[0].rgb;
+
+  schema = source ? g_settings_schema_source_lookup (source, "org.gnome.desktop.interface", TRUE) : NULL;
+  if (schema && g_settings_schema_has_key (schema, "accent-color")) {
+    settings = g_settings_new ("org.gnome.desktop.interface");
+    name = g_settings_get_string (settings, "accent-color");
+    for (guint i = 0; i < G_N_ELEMENTS (accents); i++) {
+      if (g_strcmp0 (name, accents[i].name) == 0)
+        rgb = accents[i].rgb;
+    }
+  }
+  if (sscanf (rgb, "%d,%d,%d", &red, &green, &blue) == 3) {
+    self->accent[0] = red / 255.0;
+    self->accent[1] = green / 255.0;
+    self->accent[2] = blue / 255.0;
+  }
+}
+
+
+static void
+phosh_osd_window_set_upright (PhoshOsdWindow *self)
+{
+  g_autofree char *path = g_build_filename (g_get_user_runtime_dir (), "sfduo-osd", NULL);
+  g_autofree char *tune = NULL;
+  int top = 57, length = 160;
+
+  /* $XDG_RUNTIME_DIR/sfduo-osd "<top> <length>" places it by hand, read
+   * each time it shows: tried on the device without restarting the shell */
+  if (g_file_get_contents (path, &tune, NULL, NULL))
+    sscanf (tune, "%d %d", &top, &length);
+
+  self->upright = TRUE;
+  /* against the right edge, however wide the surface comes out, and a
+   * little lower than the bubble stands, level with the keys */
+  gtk_widget_set_halign (gtk_bin_get_child (GTK_BIN (self)), GTK_ALIGN_END);
+  gtk_widget_set_margin_top (gtk_bin_get_child (GTK_BIN (self)), top);
+  gtk_widget_set_halign (self->box, GTK_ALIGN_END);
+  gtk_widget_set_halign (self->slider, GTK_ALIGN_END);
+  gtk_widget_set_size_request (self->slider, SLIDER_WIDTH, length);
+  gtk_widget_add_events (self->slider, GDK_BUTTON_PRESS_MASK | GDK_BUTTON_RELEASE_MASK |
+                         GDK_BUTTON_MOTION_MASK | GDK_TOUCH_MASK);
+  self->drag = gtk_gesture_drag_new (self->slider);
+  gtk_event_controller_set_propagation_phase (GTK_EVENT_CONTROLLER (self->drag), GTK_PHASE_CAPTURE);
+  g_signal_connect_swapped (self->drag, "drag-begin", G_CALLBACK (on_drag_begin), self);
+  g_signal_connect_swapped (self->drag, "drag-update", G_CALLBACK (on_drag_update), self);
+  g_signal_connect_swapped (self->drag, "drag-end", G_CALLBACK (on_drag_end), self);
+  gtk_style_context_add_class (gtk_widget_get_style_context (GTK_WIDGET (self)), "upright");
+  paint_accent (self);
+  gtk_orientable_set_orientation (GTK_ORIENTABLE (self->bubble), GTK_ORIENTATION_VERTICAL);
+  gtk_widget_set_no_show_all (self->icon, TRUE);
+  gtk_widget_hide (self->icon);
+  gtk_widget_set_no_show_all (self->lbl, TRUE);
+  gtk_widget_hide (self->lbl);
+  for (GtkWidget *w = self->box; w; w = w == self->box ? self->bubble : NULL) {
+    gtk_widget_set_margin_start (w, 0);
+    gtk_widget_set_margin_end (w, 0);
+    gtk_widget_set_margin_top (w, 0);
+    gtk_widget_set_margin_bottom (w, 0);
+  }
+  set_level (self, self->level);
+}
