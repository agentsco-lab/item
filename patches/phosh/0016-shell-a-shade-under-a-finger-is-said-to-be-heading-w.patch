From b28f5c6f4634b98d2714aeb3cf7d8b60989f67ee Mon Sep 17 00:00:00 2001
From: Ivan Verbovoy <145046797+iverbovoy@users.noreply.github.com>
Date: Mon, 28 Sep 2026 09:50:00 +0300
Subject: [PATCH 16/17] shell: a shade under a finger is said to be heading
 where it goes

org.sfduo.Shade.Open said a half's shade was open once its panel was
unfolded - after the finger let go and the shade had come all the way
down - and the dock, which makes room for it, set off only then. A panel
being dragged is now said to be heading away from where it stood: open
when dragged down from folded, closed when dragged up from unfolded, from
the finger's first move. Let go short of the way, it goes back and says
so. Only the dock reads this.
---
 src/shell.c | 31 +++++++++++++++++++++++++++----
 1 file changed, 27 insertions(+), 4 deletions(-)

diff --git a/src/shell.c b/src/shell.c
index 56c7acf7..cdadce69 100644
--- a/src/shell.c
+++ b/src/shell.c
@@ -331,6 +331,23 @@ static const char shade_introspection_xml[] =
   "</node>";
 
 
+/* Whether a shade is open, or on its way to be: under a finger it is
+ * heading away from where it stood - down from folded, up from unfolded -
+ * and whoever makes room for it (the dock) sets off with the finger's first
+ * move rather than after the shade has come all the way down. Let go short
+ * of the way, it goes back, and says so. */
+static gboolean
+shade_heading_open (PhoshTopPanel *panel)
+{
+  gboolean open = phosh_top_panel_get_state (panel) == PHOSH_TOP_PANEL_STATE_UNFOLDED;
+
+  if (phosh_drag_surface_get_drag_state (PHOSH_DRAG_SURFACE (panel)) ==
+      PHOSH_DRAG_SURFACE_STATE_DRAGGED)
+    return !open;
+  return open;
+}
+
+
 static const char *
 shade_open_halves (PhoshShell *self)
 {
@@ -340,11 +357,9 @@ shade_open_halves (PhoshShell *self)
   if (priv->top_panel == NULL)
     return "none";
 
-  near_open = phosh_top_panel_get_state (PHOSH_TOP_PANEL (priv->top_panel)) ==
-    PHOSH_TOP_PANEL_STATE_UNFOLDED;
+  near_open = shade_heading_open (PHOSH_TOP_PANEL (priv->top_panel));
   far_open = priv->top_panel_right != NULL &&
-    phosh_top_panel_get_state (PHOSH_TOP_PANEL (priv->top_panel_right)) ==
-    PHOSH_TOP_PANEL_STATE_UNFOLDED;
+    shade_heading_open (PHOSH_TOP_PANEL (priv->top_panel_right));
 
   /* The near panel is the one anchored to the left of the seam */
   if (near_open && far_open)
@@ -752,6 +767,10 @@ panels_create (PhoshShell *self)
                             "notify::state",
                             G_CALLBACK (on_top_panel_state_changed),
                             self);
+  g_signal_connect_swapped (priv->top_panel,
+                            "notify::drag-state",
+                            G_CALLBACK (shade_publish),
+                            self);
 
   if (priv->top_panel_right) {
     g_signal_connect_swapped (priv->top_panel_right,
@@ -762,6 +781,10 @@ panels_create (PhoshShell *self)
                               "notify::state",
                               G_CALLBACK (on_top_panel_state_changed),
                               self);
+    g_signal_connect_swapped (priv->top_panel_right,
+                              "notify::drag-state",
+                              G_CALLBACK (shade_publish),
+                              self);
   }
 
   g_signal_connect_swapped (priv->home,
