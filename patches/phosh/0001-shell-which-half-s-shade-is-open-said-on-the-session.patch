From 3c9a5f08dee137b55b4be59a7ace6b8d6faf59ff Mon Sep 17 00:00:00 2001
From: Ivan Verbovoy <145046797+iverbovoy@users.noreply.github.com>
Date: Tue, 29 Sep 2026 10:22:52 +0300
Subject: [PATCH 01/17] shell: which half's shade is open, said on the session
 bus

org.sfduo.Shade, one read-only property Open - none, left, right or both -
so that the two-panel shell's own surfaces over phosh (the dock) keep out
of the way of a shade pulled down on their half.
---
 src/shell.c | 139 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 139 insertions(+)

diff --git a/src/shell.c b/src/shell.c
index 0dfa8a94..3b63aa51 100644
--- a/src/shell.c
+++ b/src/shell.c
@@ -150,6 +150,10 @@ typedef struct {
   PhoshDragSurface           *top_panel_right;
   /* where on the output an app was last launched from, or -1 (splash.c) */
   int                         launch_x;
+  /* Which half's shade is open, said out loud on the session bus so that
+   * anything drawing over the shell can keep out of the way. */
+  GDBusConnection            *shade_bus;
+  const char                 *shade_open;
   PhoshDragSurface           *home;
   gboolean                    overview_visible;
   GPtrArray                  *faders; /* for final fade out */
@@ -301,6 +305,139 @@ on_proximity_near_changed (PhoshShell *self)
 }
 
 
+/* {{{ Saying which half's shade is open */
+/*
+ * A shell whose display is split in two draws a shade over one half while
+ * the other half carries on. Anything of its own that sits above the shell -
+ * a launcher along the bottom edge, say - has no way to know that, and its
+ * gestures go on working through a shade the hand thinks is in front of
+ * them. So the shell says so: `org.sfduo.Shade` on the session bus, one
+ * read-only property, "none", "left", "right" or "both", with the usual
+ * PropertiesChanged behind it.
+ */
+#define SHADE_BUS_NAME "org.sfduo.Shade"
+#define SHADE_OBJECT_PATH "/org/sfduo/Shade"
+#define SHADE_IFACE "org.sfduo.Shade"
+
+static const char shade_introspection_xml[] =
+  "<node>"
+  "  <interface name='org.sfduo.Shade'>"
+  "    <property name='Open' type='s' access='read'/>"
+  "  </interface>"
+  "</node>";
+
+
+static const char *
+shade_open_halves (PhoshShell *self)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+  gboolean near_open, far_open;
+
+  if (priv->top_panel == NULL)
+    return "none";
+
+  near_open = phosh_top_panel_get_state (PHOSH_TOP_PANEL (priv->top_panel)) ==
+    PHOSH_TOP_PANEL_STATE_UNFOLDED;
+  far_open = priv->top_panel_right != NULL &&
+    phosh_top_panel_get_state (PHOSH_TOP_PANEL (priv->top_panel_right)) ==
+    PHOSH_TOP_PANEL_STATE_UNFOLDED;
+
+  /* The near panel is the one anchored to the left of the seam */
+  if (near_open && far_open)
+    return "both";
+  if (near_open)
+    return "left";
+  if (far_open)
+    return "right";
+
+  return "none";
+}
+
+
+static GVariant *
+shade_get_property (GDBusConnection *connection,
+                    const char      *sender,
+                    const char      *object_path,
+                    const char      *interface_name,
+                    const char      *property_name,
+                    GError         **error,
+                    gpointer         user_data)
+{
+  PhoshShell *self = PHOSH_SHELL (user_data);
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+
+  if (g_strcmp0 (property_name, "Open") == 0)
+    return g_variant_new_string (priv->shade_open ?: "none");
+
+  return NULL;
+}
+
+static const GDBusInterfaceVTable shade_vtable = {
+  NULL, shade_get_property, NULL, { NULL, }
+};
+
+
+static void
+shade_publish (PhoshShell *self)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+  const char *open = shade_open_halves (self);
+  GVariantBuilder changed;
+
+  if (priv->shade_bus == NULL || g_strcmp0 (open, priv->shade_open) == 0)
+    return;
+
+  priv->shade_open = open;
+  g_debug ("Shade open on: %s", open);
+
+  g_variant_builder_init (&changed, G_VARIANT_TYPE ("a{sv}"));
+  g_variant_builder_add (&changed, "{sv}", "Open", g_variant_new_string (open));
+  g_dbus_connection_emit_signal (priv->shade_bus, NULL, SHADE_OBJECT_PATH,
+                                 "org.freedesktop.DBus.Properties",
+                                 "PropertiesChanged",
+                                 g_variant_new ("(sa{sv}as)", SHADE_IFACE, &changed, NULL),
+                                 NULL);
+}
+
+
+static void
+shade_service_start (PhoshShell *self)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+  g_autoptr (GDBusNodeInfo) node = NULL;
+  g_autoptr (GError) err = NULL;
+
+  if (priv->shade_bus != NULL)
+    return;
+
+  priv->shade_bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, &err);
+  if (priv->shade_bus == NULL) {
+    g_warning ("No session bus for %s: %s", SHADE_BUS_NAME, err->message);
+    return;
+  }
+
+  node = g_dbus_node_info_new_for_xml (shade_introspection_xml, &err);
+  if (node == NULL) {
+    g_warning ("Cannot describe %s: %s", SHADE_IFACE, err->message);
+    g_clear_object (&priv->shade_bus);
+    return;
+  }
+
+  if (g_dbus_connection_register_object (priv->shade_bus, SHADE_OBJECT_PATH,
+                                         node->interfaces[0], &shade_vtable,
+                                         self, NULL, &err) == 0) {
+    g_warning ("Cannot publish %s: %s", SHADE_OBJECT_PATH, err->message);
+    g_clear_object (&priv->shade_bus);
+    return;
+  }
+
+  g_bus_own_name_on_connection (priv->shade_bus, SHADE_BUS_NAME,
+                                G_BUS_NAME_OWNER_FLAGS_NONE, NULL, NULL, NULL, NULL);
+  priv->shade_open = "none";
+}
+
+/* }}} */
+
 static void
 on_top_panel_state_changed (PhoshShell *self, GParamSpec *pspec, PhoshTopPanel *top_panel)
 {
@@ -316,6 +453,7 @@ on_top_panel_state_changed (PhoshShell *self, GParamSpec *pspec, PhoshTopPanel *
   if (state != PHOSH_TOP_PANEL_STATE_UNFOLDED && priv->top_panel_right)
     state = phosh_top_panel_get_state (PHOSH_TOP_PANEL (priv->top_panel_right));
   phosh_shell_set_state (self, PHOSH_STATE_SETTINGS, state == PHOSH_TOP_PANEL_STATE_UNFOLDED);
+  shade_publish (self);
 }
 
 /* Whether every top panel is folded away. With a panel per half of the
@@ -515,6 +653,7 @@ panels_create (PhoshShell *self)
                                             PHOSH_TOP_BAR_HEIGHT));
   }
   gtk_widget_set_visible (GTK_WIDGET (priv->top_panel), TRUE);
+  shade_service_start (self);
 
   /* Home is created after the top-panel so it honors its exclusive zone */
   priv->home = PHOSH_DRAG_SURFACE (phosh_home_new (phosh_wayland_get_zwlr_layer_shell_v1 (wl),
-- 
