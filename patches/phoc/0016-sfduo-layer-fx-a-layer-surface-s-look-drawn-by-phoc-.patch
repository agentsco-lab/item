+#pragma once
+
+#include "render.h"
+#include "layer-surface.h"
+
+#include <glib.h>
+#include <pixman.h>
+#include <wlr/render/wlr_texture.h>
+#include <wlr/util/box.h>
+
+G_BEGIN_DECLS
+
+/* Visual effects on a layer surface, drawn by phoc: a client asks for them
+ * by the surface's namespace (org.sfduo.Phoc.LayerEffect) and phoc animates
+ * them on its own frames. They change how the surface looks, not where it
+ * takes input. */
+typedef struct {
+  double radius[4];             /* corners, top-left clockwise; layout px */
+  double inset[4];              /* the shape inside the surface: top, right,
+                                 * bottom, left from its edges; layout px -
+                                 * outside it nothing is drawn */
+  double alpha;                 /* multiplied into the surface's own */
+  double dim;                   /* 0 as it is .. 1 black */
+  double scale_x;               /* width, 0.5 .. 1, about anchor_x */
+  double anchor_x;              /* 0 its left edge .. 1 its right edge */
+  double seamless;              /* > 0.5: on an output with a seam, drawn as if
+                                 * the seam had no width - what reaches it is
+                                 * drawn at once on its far side */
+  double tunnel;                /* seamless, and > 0: the seam is this long a
+                                 * tunnel instead (at least its own width;
+                                 * layout px) - what goes in comes out only
+                                 * after this much more travel: an icon no
+                                 * wider goes all the way in before any of
+                                 * it comes out. The surface stands where
+                                 * phoc_sfduo_layer_fx_tunnel_x() puts it */
+  double merge;                 /* > 0: the shape flows into that of another
+                                 * merging surface beside it on its layer, a
+                                 * neck across a gap up to half this; layout
+                                 * px, the reach of the smooth union */
+  double merge_color[4];        /* the neck's colour, r g b a, 0 .. 1 */
+} PhocSfduoLayerFxParams;
+
+const PhocSfduoLayerFxParams *phoc_sfduo_layer_fx_lookup  (const char *namespace);
+gboolean                      phoc_sfduo_layer_fx_animate (const char *namespace,
+                                                           GVariant   *target,
+                                                           guint       duration_ms,
+                                                           GError    **error);
+gboolean                      phoc_sfduo_layer_fx_render  (PhocRenderContext            *ctx,
+                                                           const PhocSfduoLayerFxParams *fx,
+                                                           struct wlr_texture           *texture,
+                                                           const struct wlr_fbox        *src_box,
+                                                           const struct wlr_box         *dst_box,
+                                                           const pixman_region32_t      *damage,
+                                                           float                         alpha,
+                                                           float                         scale);
+float                         phoc_sfduo_layer_fx_tunnel_x (float x, int start, int end,
+                                                            float tunnel);
+void                          phoc_sfduo_layer_fx_render_merges (PhocRenderContext *ctx,
+                                                                 GQueue            *layer_surfaces);
+void                          phoc_sfduo_layer_fx_damage_moved (PhocOutput             *output,
+                                                                PhocLayerSurface       *layer_surface,
+                                                                const struct wlr_box   *old_geo);
+
+G_END_DECLS
