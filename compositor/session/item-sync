#!/usr/bin/env python3
"""item-sync: the black box. What Claude Code is working on here goes to the
phone as it changes, so a session can go on there when this machine loses
its power (Kyiv, 2026): the transcripts (~/.claude/projects) and the
folders being worked in, to the same paths on the phone (/home/USER/... is
made there, the phone's owner's). On the way back, transcripts the phone
wrote on go to this machine (--update: the newer copy wins, nothing is
deleted).

  item-sync            run on: a sync at the start, then on each change
                       (inotify, 3 s after the last), at least once a
                       minute; the phone's transcripts back every 10 min
  item-sync once       one sync now
  item-sync setup      the user unit written and started (systemd --user)

~/.config/item/sync, a line each:
  to USER@HOST [USER@HOST...]   where to (else the devices marked notify in
                                ~/.config/item/devices)
  path DIR                      a folder to keep on the phone (the folders
                                of running sessions go in any case)
  skip DIR                      a folder never sent, even with a session in it
  exclude PATTERN               besides target, node_modules, sysroot, out,
                                .cache, build artefacts
"""

import json
import os
import select
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "item/sync")
DEVICES = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "item/devices")
SSH = "ssh -o BatchMode=yes -o ConnectTimeout=4 -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR"
# Build trees and caches, and the files secrets usually live in (.env, keys,
# certificates): those never travel. Claude Code's transcripts travel whole
# (~/.claude/projects): what was pasted into a session is in them.
EXCLUDES = ["target", "node_modules", "sysroot", "out", ".cache", "__pycache__", "dist", "*.img", "*.img.zst", "*.zst", ".venv", "venv",
            ".env", ".env.*", "*.pem", "*.key", "*.p12", "*.pfx", "id_rsa*", "id_ed25519*", "id_ecdsa*", ".netrc", "*.kdbx", "credentials*.json"]
DEBOUNCE_S = 3.0
AT_LEAST_S = 60.0
BACK_EVERY_S = 600.0


def read(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ""


def log(msg):
    print(time.strftime("%H:%M:%S"), msg, flush=True)


def config():
    to, paths, excludes, skips = [], [], [], []
    for line in read(CONF).splitlines():
        w = line.split()
        if not w or w[0].startswith("#"):
            continue
        if w[0] == "to":
            to += [h for h in w[1:] if "@" in h]
        elif w[0] == "path" and len(w) > 1:
            paths.append(os.path.abspath(os.path.expanduser(w[1])))
        elif w[0] == "exclude" and len(w) > 1:
            excludes.append(w[1])
        elif w[0] == "skip" and len(w) > 1:
            skips.append(os.path.abspath(os.path.expanduser(w[1])))
    if not to:
        for line in read(DEVICES).splitlines():
            w = line.split()
            if w and not w[0].startswith("#") and "notify" in w[1:]:
                to += [h for h in w[1:] if "@" in h]
    return to, paths, EXCLUDES + excludes, skips


def session_dirs(skips=()):
    """The folders of the running sessions, from item-agents - but the
    ones skipped, and the home itself."""
    try:
        out = subprocess.run(["item-agents", "list"], capture_output=True, text=True, timeout=10).stdout
        dirs = [os.path.expanduser(s["cwd"]) for s in json.loads(out) if s.get("running") and s.get("cwd")]
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []
    return [d for d in dirs if d != HOME and not any(d == s or d.startswith(s + "/") for s in skips)]


class Target:
    """The phone: the first address that answers, kept until it fails."""

    def __init__(self, hosts):
        self.hosts = hosts
        self.host = None

    def pick(self):
        if self.host:
            return self.host
        for h in self.hosts:
            if subprocess.run(SSH.split() + [h, "true"], capture_output=True, timeout=12).returncode == 0:
                self.host = h
                return h
        return None

    def failed(self):
        self.host = None


def rsync(src, dst, excludes, extra=()):
    cmd = ["rsync", "-a", "--update", "--timeout=60", "-e", SSH] + [f"--exclude={e}" for e in excludes] + list(extra) + [src, dst]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode not in (0, 24):
        raise RuntimeError(r.stderr.strip().splitlines()[-1] if r.stderr.strip() else f"rsync {r.returncode}")


def sync_once(target, paths, excludes):
    host = target.pick()
    if not host:
        log("the phone does not answer")
        return False
    t = time.time()
    try:
        # The transcripts, into the phone owner's home.
        rsync(os.path.join(HOME, ".claude/projects/"), f"{host}:.claude/projects/", [])
        # The folders, to the same absolute paths (made on the phone first).
        for p in paths:
            if not os.path.isdir(p):
                continue
            rsync(p.rstrip("/") + "/", f"{host}:{p.rstrip('/')}/", excludes, extra=[f"--rsync-path=mkdir -p {json.dumps(p)} && rsync"])
    except RuntimeError as e:
        log(f"{host}: {e}")
        target.failed()
        return False
    log(f"to {host}: transcripts and {len(paths)} folder(s) in {time.time() - t:.1f} s")
    return True


def running_ids():
    """The ids of the sessions running here: their transcripts are being
    written, a copy from the phone must not land over them."""
    try:
        out = subprocess.run(["item-agents", "list"], capture_output=True, text=True, timeout=10).stdout
        return [s["id"] for s in json.loads(out) if s.get("running") and s.get("id")]
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []


def sync_back(target):
    host = target.pick()
    if not host:
        return
    try:
        keep = [f"{sid}.jsonl" for sid in running_ids()]
        rsync(f"{host}:.claude/projects/", os.path.join(HOME, ".claude/projects/"), keep)
        log(f"from {host}: transcripts back ({len(keep)} running here left alone)")
    except RuntimeError as e:
        log(f"{host}: back: {e}")
        target.failed()


def watch(dirs, excludes):
    """inotifywait on the folders: a line per change."""
    pattern = "(" + "|".join(e.replace(".", r"\.").replace("*", ".*") for e in excludes + [r"\.git/objects"]) + ")"
    cmd = ["inotifywait", "-m", "-r", "-q", "-e", "close_write,create,delete,moved_to,moved_from", "--exclude", pattern] + dirs
    return subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)


def run_on():
    to, conf_paths, excludes, skips = config()
    if not to:
        sys.exit(f"nowhere to sync to: `to USER@HOST` in {CONF}, or a device marked notify in {DEVICES}")
    target = Target(to)
    paths = sorted(set(conf_paths + session_dirs(skips)))
    sync_back(target)
    sync_once(target, paths, excludes)
    last_back = time.time()
    while True:
        dirs = [os.path.join(HOME, ".claude/projects")] + [p for p in paths if os.path.isdir(p)]
        w = watch(dirs, excludes)
        log(f"watching {len(dirs)} folders")
        pending = None
        last_sync = time.time()
        # Watched until the set of folders changes (a session in a new one).
        while True:
            timeout = 1.0
            if pending is not None:
                timeout = max(0.1, DEBOUNCE_S - (time.time() - pending))
            ready, _, _ = select.select([w.stdout], [], [], timeout)
            if ready:
                line = w.stdout.readline()
                if not line:
                    break
                pending = pending if pending is not None else time.time()
                pending = time.time()
                continue
            now = time.time()
            due = (pending is not None and now - pending >= DEBOUNCE_S) or now - last_sync >= AT_LEAST_S
            if due:
                new_paths = sorted(set(conf_paths + session_dirs(skips)))
                sync_once(target, new_paths, excludes)
                last_sync = now
                pending = None
                if new_paths != paths:
                    paths = new_paths
                    break
            if now - last_back >= BACK_EVERY_S:
                sync_back(target)
                last_back = now
        w.kill()


def setup():
    unit_dir = os.path.join(HOME, ".config/systemd/user")
    os.makedirs(unit_dir, exist_ok=True)
    me = os.path.abspath(sys.argv[0])
    with open(os.path.join(unit_dir, "item-sync.service"), "w") as f:
        f.write(f"""[Unit]
Description=item-sync: Claude Code's transcripts and folders to the phone as they change
After=network-online.target

[Service]
ExecStart={me}
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
""")
    subprocess.run(["systemctl", "--user", "daemon-reload"])
    subprocess.run(["systemctl", "--user", "enable", "--now", "item-sync.service"])
    print("item-sync.service: on (journalctl --user -u item-sync -f)")


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "run"
    if cmd == "once":
        to, paths, excludes, skips = config()
        target = Target(to)
        sync_once(target, sorted(set(paths + session_dirs(skips))), excludes)
    elif cmd == "setup":
        setup()
    elif cmd == "run":
        run_on()
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
