# item-warm: the dock's apps' files read into the page cache after the
# session is up (session/item-warm), at the lowest disk and CPU priority,
# so that the first launch after a boot is as quick as the second.
[Unit]
Description=Read the dock's apps into the page cache after boot
# Only in item's session (item-session sets WAYLAND_DISPLAY for the user's
# manager and starts this): every user's manager has the wants link, root's
# too, which ran this without a compositor - Chromium 455 restarts a day.
ConditionEnvironment=WAYLAND_DISPLAY=wayland-item
After=graphical-session.target

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
ExecStart=/usr/bin/item-warm

[Install]
WantedBy=default.target
