#!/usr/bin/env python3
"""item-agents: Claude Code sessions on this machine and on the others
(~/.config/item/devices), as item's system screen shows them, and the ways
to reach them (sysfacts.rs, kbd.rs's Agent entry).

  item-agents list              the sessions here, as JSON
  item-agents devices           this machine and the others with theirs, JSON
  item-agents hook              from Claude Code's hooks (settings.json): what
                                the session is doing, kept for `list`; the
                                devices marked `notify` told when it waits
  item-agents setup             the hooks written into ~/.claude/settings.json
  item-agents run [DIR] [--resume ID]
                                claude inside tmux (so a window may close
                                and another, from another machine, attach);
                                with no folder, the warm home session
  item-agents warm              the home session started in the background
                                (a user unit at the session's start), so
                                the first word to the agent is answered at
                                once
  item-agents open DEVICE [TMUX [ID [CWD]]]
                                a session attached (tmux) or resumed (its
                                id, in its folder), here ("-") or over ssh

A session runs inside tmux; its name is the folder's and the time it began;
the warm one at home is "home".

The hook also keeps the agent from the phone's traps (the port's
SAFETY.md, item/grid's rules): a PreToolUse hook refuses a command that
reads /sys/kernel/debug/gpio (the phone resets at once), writes a block
device or flashes (no EDL loader: a bad write bricks the Duo), stops or
restarts the vendor composer, or wipes the root.
What a session does comes from the hooks: working (a prompt sent), waiting
(Claude Code asked for something: a permission, an answer), done (it
stopped, the turn is yours), or gone. The transcript
(~/.claude/projects/<folder>/<id>.jsonl) tells the model, the turns and the
tokens.

~/.config/item/devices, a line a device: NAME USER@HOST [USER@HOST...] [notify]
  - the first address that answers is used (the home network, then
    Tailscale); `notify`: this device is told when a session here waits.
"""

import json
import shlex
import os
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local/state")), "item/agents")
DEVICES = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "item/devices")
SSH = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=3", "-o", "StrictHostKeyChecking=accept-new", "-o", "LogLevel=ERROR"]


def read(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ""


def project_dir(cwd):
    """Claude Code's folder for a working directory: the path with every
    character but letters and digits as a dash."""
    return "".join(c if c.isalnum() else "-" for c in cwd)


def model_name(mid):
    parts = mid.split("-")
    if len(parts) < 2 or parts[0] != "claude":
        return mid
    name = parts[1].capitalize()
    version = [p for p in parts[2:] if p.isdigit()]
    return name + (" " + ".".join(version) if version else "")


def transcript(path, cache={}):
    """The transcript read: the model, the turns, the tokens, the last line's
    time; cached by its size and mtime."""
    try:
        st = os.stat(path)
    except OSError:
        return None
    key = (path, st.st_size, st.st_mtime)
    if key in cache:
        return cache[key]
    t = {"model": "", "turns": 0, "tokens_in": 0, "tokens_out": 0, "last": 0}
    for line in read(path).splitlines():
        try:
            v = json.loads(line)
        except ValueError:
            continue
        ts = v.get("timestamp")
        if isinstance(ts, str):
            try:
                t["last"] = int(time.mktime(time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S")) - time.timezone)
            except ValueError:
                pass
        if v.get("type") != "assistant":
            continue
        m = v.get("message") or {}
        if m.get("model"):
            t["model"] = model_name(m["model"])
        u = m.get("usage")
        if isinstance(u, dict):
            t["turns"] += 1
            t["tokens_in"] += (u.get("input_tokens") or 0) + (u.get("cache_read_input_tokens") or 0) + (u.get("cache_creation_input_tokens") or 0)
            t["tokens_out"] += u.get("output_tokens") or 0
    cache[key] = t
    return t


def tmux_panes():
    """tmux's panes: the session name of each pane's shell, by pid."""
    try:
        out = subprocess.run(["tmux", "list-panes", "-a", "-F", "#{session_name} #{pane_pid}"], capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    panes = {}
    for line in out.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[1].isdigit():
            panes[int(parts[1])] = parts[0]
    return panes


def parent(pid):
    stat = read(f"/proc/{pid}/stat")
    try:
        return int(stat.rsplit(")", 1)[1].split()[1])
    except (IndexError, ValueError):
        return 0


def processes():
    """Claude Code's processes: pid, folder, seconds run, the tmux session
    they are in."""
    panes = tmux_panes()
    uptime = float(read("/proc/uptime").split()[0] or 0)
    ticks = os.sysconf("SC_CLK_TCK")
    out = []
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or read(f"/proc/{pid}/comm").strip() != "claude":
            continue
        try:
            cwd = os.readlink(f"/proc/{pid}/cwd")
        except OSError:
            cwd = ""
        stat = read(f"/proc/{pid}/stat")
        try:
            started = int(stat.rsplit(")", 1)[1].split()[19]) / ticks
        except (IndexError, ValueError):
            started = uptime
        # The tmux session: a pane's shell among its ancestors.
        p, session = int(pid), None
        for _ in range(12):
            if p in panes:
                session = panes[p]
                break
            p = parent(p)
            if p <= 1:
                break
        out.append({"pid": int(pid), "cwd": cwd, "since": int(max(0.0, uptime - started)), "tmux": session})
    return out


def states():
    """What the hooks last said of each session, by its id."""
    out = {}
    try:
        names = os.listdir(STATE)
    except OSError:
        return out
    for n in names:
        if n.endswith(".json"):
            try:
                out[n[:-5]] = json.loads(read(os.path.join(STATE, n)))
            except ValueError:
                pass
    return out


def list_sessions():
    """The sessions here: each a process (or a session the hooks saw end
    less than a day ago), with its state and its transcript's facts."""
    home = HOME
    short = lambda p: "~" + p[len(home):] if p.startswith(home) else p
    sessions = []
    by_cwd = {}
    for st_id, st in states().items():
        by_cwd.setdefault(st.get("cwd", ""), []).append((st_id, st))
    seen = set()
    for pr in processes():
        s = {"cwd": short(pr["cwd"]), "running": True, "since": pr["since"], "tmux": pr["tmux"], "state": "running", "message": "", "at": 0, "id": ""}
        # The newest hook state for this folder is this session's.
        cands = sorted(by_cwd.get(pr["cwd"], []), key=lambda x: x[1].get("at", 0), reverse=True)
        for st_id, st in cands:
            if st_id not in seen:
                seen.add(st_id)
                s.update({"id": st_id, "state": st.get("state", "running"), "message": st.get("message", ""), "at": st.get("at", 0)})
                t = transcript(st.get("transcript") or "")
                if t:
                    s.update(t)
                break
        if not s["id"]:
            # No hook yet: the newest transcript of the folder.
            d = os.path.join(home, ".claude/projects", project_dir(pr["cwd"]))
            try:
                files = sorted((os.path.getmtime(os.path.join(d, f)), f) for f in os.listdir(d) if f.endswith(".jsonl"))
            except OSError:
                files = []
            if files:
                s["id"] = files[-1][1][:-6]
                t = transcript(os.path.join(d, files[-1][1]))
                if t:
                    s.update(t)
        sessions.append(s)
    # Sessions the hooks saw that no longer run: kept a day, to resume.
    now = int(time.time())
    for st_id, st in states().items():
        if st_id in seen or st.get("state") == "gone" or now - st.get("at", 0) > 86400:
            continue
        s = {"cwd": short(st.get("cwd", "")), "running": False, "since": 0, "tmux": None, "state": "stopped", "message": st.get("message", ""), "at": st.get("at", 0), "id": st_id}
        t = transcript(st.get("transcript") or "")
        if t:
            s.update(t)
        sessions.append(s)
    # Transcripts synced here from another machine (item-sync) and not yet
    # run here: a session to go on with, from its folder, when that
    # machine is dark. Whose it is: the device whose user's home its folder
    # is under (origin), else this machine's.
    homes = {}
    for dev in devices():
        for h in dev["hosts"]:
            homes.setdefault("/home/" + h.split("@")[0], dev["name"])
    known = {s["id"] for s in sessions}
    projects = os.path.join(home, ".claude/projects")
    try:
        dirs = [os.path.join(projects, d) for d in os.listdir(projects)]
    except OSError:
        dirs = []
    for d in dirs:
        try:
            files = sorted(((os.path.getmtime(os.path.join(d, f)), f) for f in os.listdir(d) if f.endswith(".jsonl")), reverse=True)
        except OSError:
            continue
        for mtime, f in files[:1]:
            sid = f[:-6]
            if sid in known or now - mtime > 7 * 86400:
                continue
            cwd = ""
            try:
                with open(os.path.join(d, f)) as fh:
                    for line in fh:
                        try:
                            cwd = json.loads(line).get("cwd") or ""
                        except ValueError:
                            continue
                        if cwd:
                            break
            except OSError:
                pass
            if not cwd:
                continue
            origin = next((name for h, name in homes.items() if cwd == h or cwd.startswith(h + "/")), "")
            if origin and cwd.startswith(home + "/"):
                origin = ""
            s = {"cwd": short(cwd), "running": False, "since": 0, "tmux": None, "state": "synced", "message": "", "at": int(mtime), "id": sid, "synced": True, "origin": origin}
            t = transcript(os.path.join(d, f))
            if t:
                s.update(t)
            sessions.append(s)
    sessions.sort(key=lambda s: (not s["running"], -s.get("at", 0)))
    return sessions


def devices():
    out = []
    for line in read(DEVICES).splitlines():
        w = line.split()
        if not w or w[0].startswith("#"):
            continue
        out.append({"name": w[0], "hosts": [h for h in w[1:] if "@" in h], "notify": "notify" in w[1:]})
    return out


def remote_list(dev):
    """A device's sessions over ssh, from the first address that answers."""
    for host in dev["hosts"]:
        try:
            # Not on a non-interactive shell's PATH when it is the user's own.
            r = subprocess.run(SSH + [host, "item-agents list 2>/dev/null || ~/.local/bin/item-agents list"], capture_output=True, text=True, timeout=8)
        except (OSError, subprocess.TimeoutExpired):
            continue
        if r.returncode == 0:
            try:
                return host, json.loads(r.stdout)
            except ValueError:
                return host, []
    return None, None


def cmd_devices():
    """This machine with its own sessions; each device with its own when it
    answers, else with the copies synced here of its sessions (to go on
    with here)."""
    mine = list_sessions()
    here = {"name": os.uname().nodename, "here": True, "online": True, "host": "", "sessions": [s for s in mine if not s.get("origin")]}
    out = [here]
    for dev in devices():
        host, sessions = remote_list(dev)
        if sessions is None:
            sessions = [s for s in mine if s.get("origin") == dev["name"]]
        out.append({"name": dev["name"], "here": False, "online": host is not None, "host": host or "", "sessions": sessions})
    print(json.dumps(out))


TRAPS = [
    (r"/sys/kernel/debug/gpio", "reading /sys/kernel/debug/gpio resets the Duo at once (the port's SAFETY.md)"),
    (r"(^|[\s;&|])dd\s[^|;]*of=/dev/", "dd onto a device: the Duo has no EDL loader, a bad write bricks it"),
    (r"(^|[;&|]\s*|\$\(\s*)(sudo\s+)?(mkfs|wipefs|sgdisk|parted|fdisk)\b", "writing a partition table or a filesystem on the Duo: no way back without EDL"),
    (r">\s*/dev/(block|sd|mmcblk)", "writing a block device: the Duo has no EDL loader"),
    (r"fastboot\s+(flash|erase|format|oem)", "flashing from the agent: item/grid flashes, by its rules (RAM boot first, one change per boot)"),
    (r"systemctl\s+(stop|restart|kill)\s+.*(hwcomposer|android-service|lxc@android)", "stopping or restarting the vendor composer resets the phone about one time in three"),
    (r"rm\s+(-[a-zA-Z]*r[a-zA-Z]*\s+)+(/|/\*|/userdata|/home)(\s|$)", "wiping the root or userdata"),
    (r"(^|[;&|]\s*|\$\(\s*)(sudo\s+)?(reboot|poweroff|halt|shutdown)\b", "restarting the phone ends the session: ask the owner"),
]


def guard(ev):
    """PreToolUse: a Bash command into a trap of the phone's is refused
    (exit 2, the reason to Claude Code)."""
    if ev.get("tool_name") != "Bash":
        return
    cmd = (ev.get("tool_input") or {}).get("command", "")
    import re
    for pattern, why in TRAPS:
        if re.search(pattern, cmd):
            sys.stderr.write(f"item-agents: refused: {why}. Command: {cmd[:200]}\n")
            sys.exit(2)


def cmd_hook():
    """Claude Code's hook: the event on stdin (session_id, cwd,
    transcript_path, hook_event_name, message...)."""
    try:
        ev = json.load(sys.stdin)
    except ValueError:
        return
    sid = ev.get("session_id")
    if not sid:
        return
    name = ev.get("hook_event_name", "")
    if name == "PreToolUse":
        guard(ev)
    state = {"SessionStart": "running", "UserPromptSubmit": "working", "PreToolUse": "working", "Notification": "waiting", "Stop": "done", "SessionEnd": "gone"}.get(name)
    if not state:
        return
    os.makedirs(STATE, exist_ok=True)
    path = os.path.join(STATE, sid + ".json")
    try:
        old = json.loads(read(path))
    except ValueError:
        old = {}
    st = {"state": state, "message": ev.get("message", "") if state == "waiting" else "", "at": int(time.time()), "cwd": ev.get("cwd", old.get("cwd", "")), "transcript": ev.get("transcript_path", old.get("transcript", ""))}
    with open(path + ".new", "w") as f:
        json.dump(st, f)
    os.replace(path + ".new", path)
    # The devices marked notify told, so the phone calls when the agent
    # waits (their notify-send needs the session bus).
    if state in ("waiting", "done"):
        folder = os.path.basename(st["cwd"].rstrip("/")) or "~"
        title = f"{folder}: " + ("Claude Code is waiting" if state == "waiting" else "Claude Code is done")
        body = st["message"] or ("" if state == "waiting" else "The turn is yours")
        me = os.uname().nodename
        for dev in devices():
            if not dev["notify"]:
                continue
            for host in dev["hosts"]:
                # shlex.quote, not json.dumps: a $(...) or a backtick inside
                # double quotes would run on the notified machine.
                cmd = f"export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus; notify-send -a {shlex.quote('Agent on ' + me)} -i item-agent {shlex.quote(title)} {shlex.quote(body)}"
                try:
                    r = subprocess.run(SSH + [host, cmd], capture_output=True, timeout=6)
                except (OSError, subprocess.TimeoutExpired):
                    continue
                if r.returncode == 0:
                    break


def cmd_setup():
    """The hooks into ~/.claude/settings.json, the rest of it kept."""
    path = os.path.join(HOME, ".claude/settings.json")
    try:
        s = json.loads(read(path) or "{}")
    except ValueError:
        s = {}
    hooks = s.setdefault("hooks", {})
    for ev in ("SessionStart", "UserPromptSubmit", "PreToolUse", "Notification", "Stop", "SessionEnd"):
        entries = hooks.setdefault(ev, [])
        if not any("item-agents hook" in h.get("command", "") for e in entries for h in e.get("hooks", [])):
            entries.append({"hooks": [{"type": "command", "command": "item-agents hook"}]})
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".new", "w") as f:
        json.dump(s, f, indent=2)
        f.write("\n")
    os.replace(path + ".new", path)
    print(f"{path}: item's hooks in")


def claude_path():
    for c in (os.path.join(HOME, ".local/bin/claude"), "claude"):
        if os.path.exists(c) or c == "claude":
            return c
    return "claude"


def cmd_run(args):
    """claude inside tmux, attached: a new session named after the folder
    and the minute, or the session resumed."""
    cwd = HOME
    resume = None
    rest = []
    i = 0
    while i < len(args):
        if args[i] == "--resume" and i + 1 < len(args):
            resume = args[i + 1]
            i += 2
        elif os.path.isdir(os.path.expanduser(args[i])):
            cwd = os.path.abspath(os.path.expanduser(args[i]))
            i += 1
        else:
            rest.append(args[i])
            i += 1
    # Home, nothing to resume: the warm session, if it is up.
    if cwd == HOME and not resume and not rest and subprocess.run(["tmux", "has-session", "-t", "home"], capture_output=True).returncode == 0:
        os.execvp("tmux", ["tmux", "attach", "-t", "home"])
    name = "home" if cwd == HOME and not resume else f"{os.path.basename(cwd.rstrip('/')) or 'home'}-{time.strftime('%H%M')}"
    claude = [claude_path()] + (["--resume", resume] if resume else []) + rest
    os.execvp("tmux", ["tmux", "new-session", "-A", "-s", name, "-c", cwd] + claude)


def cmd_warm():
    """The home session started detached, unless it is up."""
    if subprocess.run(["tmux", "has-session", "-t", "home"], capture_output=True).returncode == 0:
        return
    subprocess.run(["tmux", "new-session", "-d", "-s", "home", "-c", HOME, claude_path()], check=False)
    print("home: warm")


def cmd_open(args):
    """Attach to a session: `open DEVICE TMUX ID CWD` ("-" for this machine,
    no tmux session, no id): attached to its tmux session, else resumed
    from its transcript in its folder, here or over ssh."""
    if len(args) < 1:
        sys.exit("item-agents open DEVICE [TMUX [ID [CWD]]]")
    dev_name = args[0]
    tmux = args[1] if len(args) > 1 and args[1] != "-" else None
    sid = args[2] if len(args) > 2 and args[2] != "-" else None
    cwd = args[3] if len(args) > 3 else "~"
    if tmux:
        there = f"tmux attach -t {shlex.quote(tmux)}"
    elif sid:
        there = f"item-agents run {shlex.quote(cwd)} --resume {shlex.quote(sid)} 2>/dev/null || ~/.local/bin/item-agents run {shlex.quote(cwd)} --resume {shlex.quote(sid)}"
    else:
        sys.exit("nothing to open: no tmux session and no id")
    if dev_name in ("-", os.uname().nodename):
        if tmux:
            os.execvp("tmux", ["tmux", "attach", "-t", tmux])
        cmd_run([cwd, "--resume", sid])
    for dev in devices():
        if dev["name"] != dev_name:
            continue
        for host in dev["hosts"]:
            try:
                r = subprocess.run(SSH + [host, "true"], capture_output=True, timeout=8)
            except (OSError, subprocess.TimeoutExpired):
                continue
            if r.returncode == 0:
                os.execvp("ssh", ["ssh", "-t", "-o", "StrictHostKeyChecking=accept-new", "-o", "LogLevel=ERROR", host, there])
        sys.exit(f"{dev_name}: not reachable")
    sys.exit(f"{dev_name}: not in {DEVICES}")


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "list"
    if cmd == "list":
        print(json.dumps(list_sessions()))
    elif cmd == "devices":
        cmd_devices()
    elif cmd == "hook":
        cmd_hook()
    elif cmd == "setup":
        cmd_setup()
    elif cmd == "run":
        cmd_run(args[1:])
    elif cmd == "warm":
        cmd_warm()
    elif cmd == "open":
        cmd_open(args[1:])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
