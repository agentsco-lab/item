#!/bin/sh
# item-session: item on its own compositor, as phosh-session starts phosh:
# the compositor, with gnome-session for the rest of the session (the GNOME
# settings daemons, the on-screen keyboard, the apps that autostart).
# item.service runs it as the user on tty7; it can also be run from a tty.
#
# ITEM_COMPOSITOR overrides the binary (tests run one from /tmp).
COMPOSITOR=${ITEM_COMPOSITOR:-/usr/libexec/item/item-compositor}
# The owner's own variables for the compositor (experiments: LOG_FRAMES,
# TURN_MS, FRAMES_COUNT...): item.service is a system unit, so the user's
# environment.d does not reach it; this file does.
[ -r "$HOME/.config/item/env" ] && . "$HOME/.config/item/env"

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=item:GNOME
export XDG_SESSION_DESKTOP=item
# The output item-composer-fresh chose (/etc/item/output, unless the own
# one failed this boot): the own one is the compositor's to open.
[ "$(cat /run/item-output 2>/dev/null)" = kms ] && export ITEM_OUTPUT=kms

# Hybris' EGL for the compositor; its clients are told wayland (state.rs).
export EGL_PLATFORM=hwcomposer
export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_libhybris.json

# item's overlay of the XDG configuration: the portals' choice for item, and
# copies of the port's old autostarts marked NotShowIn=item (the compositor
# has its own dock, system screen, pen sheet, fingerprint client and
# brightness).
ITEM_XDG=/usr/share/item/xdg
if [ -d "$ITEM_XDG" ]; then
  case ":$XDG_CONFIG_DIRS:" in
    *":$ITEM_XDG:"*) ;;
    *) export XDG_CONFIG_DIRS="$ITEM_XDG:${XDG_CONFIG_DIRS:-/etc/xdg}" ;;
  esac
fi

# The user's services - the portals, apps started by D-Bus - told of this
# session; the portals started again with it.
if [ -n "$DBUS_SESSION_BUS_ADDRESS" ]; then
  VARS="XDG_CURRENT_DESKTOP=$XDG_CURRENT_DESKTOP WAYLAND_DISPLAY=wayland-item${XDG_CONFIG_DIRS:+ XDG_CONFIG_DIRS=$XDG_CONFIG_DIRS}"
  systemctl --user set-environment $VARS 2>/dev/null
  dbus-update-activation-environment $VARS 2>/dev/null
  systemctl --user stop xdg-desktop-portal.service xdg-desktop-portal-gtk.service xdg-desktop-portal-phosh.service xdg-desktop-portal-gnome.service 2>/dev/null
  # item's own services, now that the manager knows this session (their
  # ConditionEnvironment; default.target came before it did). On a fresh
  # phone the warm-ups (the page cache, Chromium) wait for the first setup
  # to end - it starts them (setup.rs): the setup has the phone to itself
  # while the rest of the session is still starting.
  if [ -e "${XDG_CONFIG_HOME:-$HOME/.config}/item/setup-done" ]; then
    systemctl --user start --no-block item-warm.service item-chromium.service 2>/dev/null
  fi
  systemctl --user start --no-block item-agent-home.service 2>/dev/null
fi

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
  echo "item-session: no session bus, starting one"
  DBUS_RUN_SESSION="dbus-run-session --"
fi

# --no-reexec: gnome-session would run itself again through a login shell,
# and Droidian's profile sets XDG_CURRENT_DESKTOP=Phosh:GNOME there. The
# compositor starts it through a login shell already, with item:GNOME after.
exec $DBUS_RUN_SESSION "$COMPOSITOR" --session "gnome-session --no-reexec --session=item" "$@"
